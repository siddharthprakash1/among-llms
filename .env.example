# Among LLMs runs with ZERO setup using the built-in deterministic `mock` brain.
# Everything below is OPTIONAL — add keys/endpoints to seat real models at the table.

# --- OpenAI-compatible (OpenAI, OpenRouter, Together, LM Studio, etc.) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Comma-separated model ids to expose in the arena:
# OPENAI_MODELS=gpt-4o-mini,gpt-4o

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODELS=claude-haiku-4-5-20251001,claude-sonnet-4-6

# --- Ollama (local, free) ---
# Set the base URL to enable. Default port shown.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODELS=llama3.1,qwen2.5,mistral

# --- Public hosting (all optional; see docs/DEPLOY.md) ---
# With none of these set the app behaves exactly as a local install.
# Store directory. Strict: if it is not writable the app reports unhealthy instead of using a temp dir.
# ARENA_DATA_DIR=/data
# Operator secret (16+ characters), sent as "Authorization: Bearer <token>".
# ARENA_ADMIN_TOKEN=
# What visitors may start: open (anything) | bots (bot games only) | off (nothing).
# Defaults to bots when ARENA_ADMIN_TOKEN is set, otherwise open.
# ARENA_PUBLIC_MODE=bots
# Starts per minute per client (games, human games and tournaments together).
# ARENA_RATE_LIMIT=6
# Total visitor starts per 24 hours, all clients combined.
# ARENA_DAILY_GAMES=2000
# Standalone games running at once (live, human and blocking runs).
# ARENA_MAX_GAMES=4
# Tournaments running at once.
# ARENA_MAX_TOURNAMENTS=1
# Request header that carries the client IP (fly-client-ip on Fly.io).
# ARENA_IP_HEADER=fly-client-ip
